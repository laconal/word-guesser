{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Obyasni",
  "version": "0.1.0",
  "identifier": "com.stedysherm.allias",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Объясни!",
        "width": 420,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "msi",
      "nsis"
    ],
    "category": "Game",
    "shortDescription": "Объясни! — игра на объяснение слов",
    "longDescription": "Party-игра: объясняйте слова, не называя их. Встроенный словарь на русском и английском, свои списки слов с импортом и экспортом (Excel, JSON, SQL).",
    "copyright": "© 2026",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "language": [
          "ru-RU",
          "en-US"
        ],
        "upgradeCode": "C1A85051-E523-5CB3-9DAC-D8AA60FC4174"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "section": "games",
        "priority": "optional",
        "desktopTemplate": "linux/obyasni.desktop"
      }
    }
  }
}
